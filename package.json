{
  "name": "kadai-hisho",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": { "node": "26.x", "pnpm": "11.x" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint eslint.config.js scripts/agent-merge*.mjs scripts/notify-decisions.test.mjs && pnpm -r lint",
    "test": "pnpm test:agent-merge && pnpm test:notify-decisions && pnpm -r test",
    "test:agent-merge": "node --test scripts/agent-merge.test.mjs",
    "test:notify-decisions": "node --test scripts/notify-decisions.test.mjs",
    "agent-merge": "node scripts/agent-merge.mjs",
    "build": "pnpm -r build",
    "gcp-build": "pnpm --filter server... build",
    "start": "pnpm --filter server start",
    "emulators": "firebase emulators:start --project demo-kadai-hisho",
    "test:observations:emulator": "firebase emulators:exec --project demo-kadai-hisho --only auth,firestore \"pnpm --filter server test:emulator\"",
    "emulators:web": "firebase emulators:start --project demo-kadai-hisho --only auth,hosting",
    "progress": "node scripts/plan-progress.mjs",
    "check:samples": "node scripts/check-samples.mjs",
    "metrics:m1": "pnpm --filter @kadai-hisho/core build && node scripts/metrics-m1.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.35.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
