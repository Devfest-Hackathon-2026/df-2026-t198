{
  "manifest_version": 3,
  "name": "ToDoku",
  "description": "ToDoku（トドク）は大学のLMSから課題を集め、時間割・カレンダー・メールで次の一歩を知らせます。",
  "version": "0.0.0",
  "minimum_chrome_version": "105",
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://lms.gakusei.kyoto-u.ac.jp/*",
    "https://www.k.kyoto-u.ac.jp/*",
    "https://k.kyoto-u.ac.jp/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/todoku-icon-16.png",
    "48": "icons/todoku-icon-48.png",
    "128": "icons/todoku-icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/todoku-icon-16.png",
      "48": "icons/todoku-icon-48.png",
      "128": "icons/todoku-icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://www.googleapis.com https://gmail.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://lms.gakusei.kyoto-u.ac.jp"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.ynu.ac.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lms.gakusei.kyoto-u.ac.jp/*"
      ],
      "js": [
        "kulms-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.k.kyoto-u.ac.jp/student/*",
        "https://k.kyoto-u.ac.jp/student/*"
      ],
      "js": [
        "kulasis-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
