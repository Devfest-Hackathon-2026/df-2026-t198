{
  "manifest_version": 3,
  "name": "課題の秘書",
  "version": "0.0.0",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://lms.ynu.ac.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
