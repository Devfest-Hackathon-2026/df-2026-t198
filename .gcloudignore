# Upload only the files needed by the server buildpacks build.
**
!Procfile
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!packages/
!packages/core/
!packages/core/package.json
!packages/core/tsconfig.json
!packages/core/tsconfig.build.json
!packages/core/src/
!packages/core/src/*.ts
!packages/server/
!packages/server/package.json
!packages/server/tsconfig.json
!packages/server/tsconfig.build.json
!packages/server/src/
!packages/server/src/*.ts
!packages/server/src/announcements/
!packages/server/src/announcements/*.ts
!packages/server/src/calendar/
!packages/server/src/calendar/*.ts
!packages/server/src/demo/
!packages/server/src/demo/*.ts
!packages/server/src/digest/
!packages/server/src/digest/*.ts
!packages/server/src/http/
!packages/server/src/http/*.ts
!packages/server/src/manual-assignments/
!packages/server/src/manual-assignments/*.ts
!packages/server/src/notifications/
!packages/server/src/notifications/*.ts
!packages/server/src/observations/
!packages/server/src/observations/*.ts
!packages/server/src/plans/
!packages/server/src/plans/*.ts
!packages/server/src/runtime/
!packages/server/src/runtime/*.ts
!packages/server/src/sessions/
!packages/server/src/sessions/*.ts
!packages/server/src/sharing/
!packages/server/src/sharing/*.ts
